{
  "version": 1,
  "name": "default",
  "cutout": {
    "model": "birefnet-general",
    "post_process_mask": true,
    "alpha_matting": false,
    "inference_max_side": 2048,
    "confidence": {
      "min_coverage": 0.02,
      "max_coverage": 0.92,
      "max_edge_softness": 0.35
    }
  },
  "grade": {
    "auto_tone": {
      "enabled": true,
      "measure_on": "subject",
      "gray_world": true,
      "clip_percent": 0.5,
      "target_luma": 0.55,
      "strength": 0.8
    },
    "lut": {
      "file": null,
      "strength": 1.0
    }
  },
  "sticker": {
    "border": {
      "width_ratio": 0.02,
      "min_width": 2,
      "color": [255, 255, 255, 255],
      "smooth": 1.0,
      "antialias": 0.8
    },
    "shadow": {
      "enabled": true,
      "offset": [0, 8],
      "blur": 7,
      "color": [83, 77, 69, 85]
    }
  },
  "output": {
    "format": "png",
    "trim_to_content": true,
    "padding": 12
  }
}
